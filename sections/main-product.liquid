{%- liquid
  assign v = product.selected_or_first_available_variant
  assign featured_id = v.featured_media.id | default: product.featured_media.id
  assign picker_id = 'vp-' | append: section.id
-%}
<div class="wrap" data-product>
  <nav class="crumbs" aria-label="Você está em">
    <a href="{{ routes.root_url }}">Início</a> /
    {%- if collection -%}<a href="{{ collection.url }}">{{ collection.title }}</a> /{%- endif -%}
    <span>{{ product.title }}</span>
  </nav>

  <div class="pdp">
    <div class="pdp-gallery">
      <div class="pdp-main">
        {%- for media in product.media -%}
          {%- assign media_alt = media.alt | default: product.title | escape -%}
          <div class="pdp-slide{% if media.id == featured_id %} on{% endif %}" data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- assign loading = 'lazy' -%}
                {%- if media.id == featured_id -%}{%- assign loading = 'eager' -%}{%- endif -%}
                {{ media | image_url: width: 1200 | image_tag: widths: '500,800,1200', sizes: '(min-width: 820px) 55vw, 100vw', alt: media_alt, loading: loading }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag }}
              {%- when 'video' -%}
                {{ media | video_tag: controls: true, image_size: '1200x' }}
              {%- else -%}
                {{ media | media_tag }}
            {%- endcase -%}
          </div>
        {%- else -%}
          <div class="pdp-slide on">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="pdp-thumbs">
          {%- for media in product.media -%}
            <button type="button" data-thumb="{{ media.id }}" class="{% if media.id == featured_id %}on{% endif %}" aria-label="Ver imagem {{ forloop.index }}">
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp-info">
      <h1 class="pdp-title disp">{{ product.title }}</h1>
      <div class="pdp-sku" data-sku>{% if v.sku != blank %}Cód.: {{ v.sku }}{% endif %}</div>
      {% render 'rating', product: product %}
      {% render 'price-br', price: v.price, compare: v.compare_at_price, big: true %}

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <fieldset class="opt">
            <legend>{{ option.name }}: <b data-opt-label="{{ forloop.index0 }}">{{ option.selected_value }}</b></legend>
            <div class="pills">
              {%- for value in option.values -%}
                <label class="pill">
                  <input type="radio" form="{{ picker_id }}" name="{{ picker_id }}-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" data-opt-index="{{ forloop.parentloop.index0 }}"{% if option.selected_value == value %} checked{% endif %}>
                  <span>{{ value }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      {%- form 'product', product, class: 'pdp-form js-ajax-cart', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ v.id }}" data-variant-id>
        <div class="pdp-buy">
          <div class="qty">
            <button type="button" data-qty-btn="-1" aria-label="Diminuir quantidade">−</button>
            <input type="number" name="quantity" value="1" min="1" aria-label="Quantidade">
            <button type="button" data-qty-btn="1" aria-label="Aumentar quantidade">+</button>
          </div>
          <button class="btn btn-y btn-lg" type="submit" name="add"{% unless v.available %} disabled{% endunless %}>
            {%- if v.available -%}Adicionar ao carrinho{%- else -%}Esgotado{%- endif -%}
          </button>
        </div>
        {%- if section.settings.show_dynamic_checkout -%}
          {{ form | payment_button }}
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.perk_1 != blank or section.settings.perk_2 != blank or section.settings.perk_3 != blank -%}
        <div class="pdp-perks">
          {%- if section.settings.perk_1 != blank -%}<div>{% render 'icon', name: 'truck', size: 20 %}<span>{{ section.settings.perk_1 }}</span></div>{%- endif -%}
          {%- if section.settings.perk_2 != blank -%}<div>{% render 'icon', name: 'pix', size: 20 %}<span>{{ section.settings.perk_2 }}</span></div>{%- endif -%}
          {%- if section.settings.perk_3 != blank -%}<div>{% render 'icon', name: 'shield', size: 20 %}<span>{{ section.settings.perk_3 }}</span></div>{%- endif -%}
        </div>
      {%- endif -%}

      <div>
        {%- if product.description != blank -%}
          <details class="acc" open>
            <summary>Descrição</summary>
            <div class="rte">{{ product.description }}</div>
          </details>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'collapsible' -%}
            {%- assign content = block.settings.content -%}
            {%- if block.settings.page != blank -%}{%- assign content = block.settings.page.content -%}{%- endif -%}
            {%- if content != blank -%}
              <details class="acc" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.title }}</summary>
                <div class="rte">{{ content }}</div>
              </details>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- unless product.has_only_default_variant -%}
    <script type="application/json" data-product-json>{{ product | json }}</script>
  {%- endunless -%}
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.featured_media -%}
  "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
  {%- endif -%}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
      "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "price": {{ variant.price | divided_by: 100.00 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "url": {{ request.origin | append: variant.url | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "Produto",
  "settings": [
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Mostrar botão de compra rápida", "default": false, "info": "Botão do tipo \"Comprar agora\" que leva direto ao checkout." },
    { "type": "header", "content": "Vantagens abaixo do botão" },
    { "type": "text", "id": "perk_1", "label": "Linha 1", "default": "Frete grátis acima de R$ 199 para todo o Brasil" },
    { "type": "text", "id": "perk_2", "label": "Linha 2", "default": "5% de desconto pagando no Pix" },
    { "type": "text", "id": "perk_3", "label": "Linha 3", "default": "Compra 100% segura" }
  ],
  "blocks": [
    {
      "type": "collapsible",
      "name": "Aba de informação",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Informações nutricionais" },
        { "type": "richtext", "id": "content", "label": "Conteúdo" },
        { "type": "page", "id": "page", "label": "Ou puxar de uma página" }
      ]
    }
  ]
}
{% endschema %}
