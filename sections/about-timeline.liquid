{%- if section.blocks.size > 0 -%}
<section class="about-timeline">
  <div class="wrap">
    <div class="shelf-head"><h2 class="disp">{{ section.settings.title }}</h2></div>
    <ol class="timeline">
      {%- for block in section.blocks -%}
        <li class="tl-item" {{ block.shopify_attributes }}>
          <span class="tl-year">{{ block.settings.year }}</span>
          <span class="tl-dot" aria-hidden="true"></span>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Quem somos: trajetória",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Nossa trajetória" }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Marco",
      "settings": [
        { "type": "text", "id": "year", "label": "Ano", "default": "1999" },
        { "type": "text", "id": "text", "label": "Texto", "default": "Início da atuação no mercado de amendoim" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Quem somos: trajetória" }]
}
{% endschema %}
