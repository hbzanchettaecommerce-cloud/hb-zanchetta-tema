{% layout 'password' %}
<div class="password-box">
  <img src="{{ 'logo-hb.png' | asset_url }}" alt="{{ shop.name }}" width="260" height="149">
  <h1 class="disp">Em breve</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password' -%}
    {%- if form.errors -%}<div class="form-error">{{ form.errors | default_errors }}</div>{%- endif -%}
    <input class="input" type="password" name="password" placeholder="Senha de acesso" aria-label="Senha" autocomplete="current-password">
    <button class="btn btn-y" type="submit">Entrar</button>
  {%- endform -%}
</div>
