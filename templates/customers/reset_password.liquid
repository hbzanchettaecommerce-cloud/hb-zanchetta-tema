<div class="wrap">
  <div class="auth">
    <h1 class="disp">Nova senha</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field">
        <label for="rp-pass">Nova senha</label>
        <input class="input" type="password" id="rp-pass" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="rp-pass2">Confirme a senha</label>
        <input class="input" type="password" id="rp-pass2" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button class="btn btn-y btn-block btn-lg" type="submit">Salvar senha</button>
    {%- endform -%}
  </div>
</div>
