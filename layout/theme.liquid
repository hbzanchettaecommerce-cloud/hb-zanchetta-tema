<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'pt-BR' }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_primary }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} – Página {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {% render 'meta-tags' %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..900&family=DM+Sans:opsz,wght@9..40,400..700&display=swap">

  <style>
    :root {
      --blue: {{ settings.color_primary }};
      --blue-deep: {{ settings.color_primary_dark }};
      --yellow: {{ settings.color_accent }};
      --cream: {{ settings.color_cream }};
      --ink: {{ settings.color_text }};
      --sale: {{ settings.color_sale }};
      --pix: {{ settings.color_pix }};
    }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>

<body class="template-{{ template.name }}">
  <a class="skip-link" href="#main">Pular para o conteúdo</a>

  {% sections 'header-group' %}

  <main id="main" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- if settings.whatsapp_number != blank -%}
    {%- assign wpp_number = settings.whatsapp_number | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '+' -%}
    {%- unless wpp_number contains '55' and wpp_number.size > 11 -%}
      {%- assign wpp_number = '55' | append: wpp_number -%}
    {%- endunless -%}
    <a class="wpp" href="https://wa.me/{{ wpp_number }}?text={{ settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener" aria-label="Fale com a gente no WhatsApp">
      {% render 'icon', name: 'whatsapp', size: 30 %}
    </a>
  {%- endif -%}

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    window.HB = {
      pix: {{ settings.pix_discount | default: 0 }},
      instMax: {{ settings.installments_max | default: 1 }},
      instMin: {{ settings.installment_min | default: 10 }},
      mascotMini: {{ 'mascote-joinha-mini.png' | asset_url | json }},
      routes: {
        root: {{ routes.root_url | json }},
        cart: {{ routes.cart_url | json }},
        cartAdd: {{ routes.cart_add_url | json }}
      }
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
