{%- paginate blog.articles by 9 -%}
<div class="wrap" style="padding-bottom: 48px;">
  <nav class="crumbs" aria-label="Você está em"><a href="{{ routes.root_url }}">Início</a> / <span>{{ blog.title }}</span></nav>
  <header class="coll-head"><h1 class="disp">{{ blog.title }}</h1></header>
  <div class="blog-grid">
    {%- for article in blog.articles -%}
      <a class="post-card" href="{{ article.url }}">
        {%- if article.image -%}
          {{ article.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: '' }}
        {%- endif -%}
        <div>
          <small>{{ article.published_at | date: '%d/%m/%Y' }}</small>
          <h2>{{ article.title }}</h2>
          <p style="margin: 0; color: var(--muted); font-size: 14px;">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
        </div>
      </a>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}
    <nav class="pagination" aria-label="Páginas">{{ paginate | default_pagination: next: '›', previous: '‹' }}</nav>
  {%- endif -%}
</div>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
