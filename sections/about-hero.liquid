{%- liquid
  if section.settings.image != blank
    assign hero_src = section.settings.image | image_url: width: 2000
  else
    assign hero_src = 'fabrica-aerea.jpg' | asset_url
  endif
-%}
<section class="about-hero">
  <div class="wrap">
    <div class="about-hero-box" style="--about-img: url('{{ hero_src }}');">
      <div class="about-hero-copy">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h1 class="disp">{{ section.settings.heading }}</h1>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quem somos: capa",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto de fundo", "info": "Se vazio, usa a foto aérea da fábrica que veio com o tema." },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "Nossa história" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Da lavoura de <em>Borborema</em> para a mesa de todo o Brasil" },
    { "type": "textarea", "id": "text", "label": "Texto" }
  ],
  "presets": [{ "name": "Quem somos: capa" }]
}
{% endschema %}
