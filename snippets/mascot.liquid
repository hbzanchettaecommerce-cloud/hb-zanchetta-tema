{%- comment -%}
  Mascote da HB Zanchetta (esquilo). Os arquivos ficam em assets/mascote-*.png.
  Uso: {% render 'mascot', name: 'entregador', class: 'mascot', loading: 'lazy' %}
  Nomes: apontando, bracos-cruzados, comemorando, entregador, maos-na-cintura,
         prancheta, notebook, mostrando, joinha
{%- endcomment -%}
{%- if name != blank and name != 'none' -%}
  {%- liquid
    assign w = 405
    assign h = 540
    if name == 'apontando' or name == 'bracos-cruzados' or name == 'comemorando'
      assign w = 540
    endif
  -%}
  <img class="{{ class | default: 'mascot' }}" src="{{ 'mascote-' | append: name | append: '.png' | asset_url }}" alt="" width="{{ w }}" height="{{ h }}" loading="{{ loading | default: 'lazy' }}" decoding="async">
{%- endif -%}
