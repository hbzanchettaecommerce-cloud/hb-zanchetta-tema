<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'pt-BR' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }} – Em breve</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..900&family=DM+Sans:opsz,wght@9..40,400..700&display=swap">
  <style>
    :root {
      --blue: {{ settings.color_primary }};
      --blue-deep: {{ settings.color_primary_dark }};
      --yellow: {{ settings.color_accent }};
      --cream: {{ settings.color_cream }};
      --ink: {{ settings.color_text }};
      --sale: {{ settings.color_sale }};
      --pix: {{ settings.color_pix }};
    }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="password-body">
  {{ content_for_layout }}
</body>
</html>
